{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "build-test-agent.input.v1",
  "title": "Build & Test Agent \u2014 Input Contract (v1)",
  "description": "Input contract for the Build & Test Agent. Receives code-generator output and runs build/test cycles with debugging-and-error-recovery on failures.",
  "type": "object",
  "required": [
    "run_id",
    "stage_id",
    "user_request",
    "predecessor_artifacts",
    "unit_name",
    "skills_required",
    "skill_paths_resolved"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9-]+$"
    },
    "stage_id": {
      "const": "build-test-agent"
    },
    "user_request": {
      "type": "string",
      "minLength": 1
    },
    "predecessor_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "code-generator output for this unit"
    },
    "unit_name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9-]+$"
    },
    "skills_required": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3,
      "default": [
        "using-agent-skills",
        "test-driven-development",
        "debugging-and-error-recovery"
      ]
    },
    "skill_paths_resolved": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "budget": {
      "type": "object"
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "require_human_approval"
      ]
    },
    "context_pointers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "locks_required": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "model_override": {
      "type": "string",
      "description": "Model to use for this stage. Overrides tool default. Set by orchestrator from budgets/default.yaml."
    },
    "design_system_path": {
      "type": "string",
      "description": "Path to design-system/ root. Set by project-profile when ui=true. Injected by orchestrator Step B.3 alongside browser-testing-with-devtools skill. Null/absent means no design system available."
    },
    "has_figma_data": {
      "type": "boolean",
      "description": "Set by project-profile when figma/ dir or *.figma.json files exist in the workspace."
    },
    "has_stitch_data": {
      "type": "boolean",
      "description": "Set by project-profile when stitch/ dir or *.stitch.json files exist in the workspace."
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Paths touched by this unit (from code-generator files_written / artifacts). Used for affected-test subsetting. Prefer this over git diff HEAD~1 during Construction."
    },
    "test_scope": {
      "type": "string",
      "enum": ["affected", "full"],
      "default": "affected",
      "description": "affected = subset via changed_files/codegraph; full = entire suite (wave or Construction closure only)."
    },
    "token_bridge_artifacts": {
      "type": "array",
      "description": "Token Bridge outputs (tokens.css, tailwind.config.js, token-prompt.md). Generated by factory_token_bridge.py prepare.",
      "items": {
        "type": "object",
        "required": [
          "type",
          "path"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "css",
              "tailwind",
              "prompt"
            ]
          },
          "path": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "default": []
    },
    "continuation": {
      "type": "object",
      "description": "In-stage resume cursor. See shared/continuation.v1.json and runtime/progress-trace.md.",
      "required": ["mode", "progress_path"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["fresh", "resume"]
        },
        "progress_path": {
          "type": "string",
          "minLength": 1
        },
        "resume_from": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "last_seq": { "type": "integer", "minimum": 0 },
            "attempt": { "type": "integer", "minimum": 1 },
            "task_id": { "type": "string" },
            "next_action": { "type": "string" },
            "completed_task_ids": {
              "type": "array",
              "items": { "type": "string" }
            },
            "skills_satisfied": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string" },
                  "evidence": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "context_snapshot": {
      "type": "object",
      "description": "Condensed historical context injected by the orchestrator before each stage spawn. See shared/context-snapshot.v1.json for schema.",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "depth": {
          "type": "string",
          "enum": [
            "minimal",
            "standard",
            "comprehensive"
          ]
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "project_context": {
          "type": "object"
        },
        "current_state": {
          "type": "object"
        },
        "recent_decisions": {
          "type": "array"
        },
        "stage_timeline": {
          "type": "array"
        },
        "open_items": {
          "type": "object"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recent_handoffs": {
          "type": "array"
        },
        "markdown": {
          "type": "string",
          "description": "Full markdown representation of the snapshot"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}