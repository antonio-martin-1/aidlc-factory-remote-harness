{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ship-agent.input.v1",
  "title": "Ship Agent \u2014 Input Contract (v1)",
  "description": "Input contract for the Ship Agent stage. Receives all construction and review outputs to produce release notes, ADRs, CHANGELOG updates, and CI/CD wiring.",
  "type": "object",
  "required": [
    "run_id",
    "stage_id",
    "user_request",
    "predecessor_artifacts",
    "skills_required",
    "skill_paths_resolved"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9-]+$"
    },
    "stage_id": {
      "const": "ship-agent"
    },
    "user_request": {
      "type": "string",
      "minLength": 1
    },
    "predecessor_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "All construction + review outputs"
    },
    "project_profile": {
      "type": "object",
      "properties": {
        "ui": {
          "type": "boolean"
        },
        "api": {
          "type": "boolean"
        },
        "has_legacy": {
          "type": "boolean"
        }
      }
    },
    "skills_required": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3,
      "default": [
        "using-agent-skills",
        "shipping-and-launch",
        "git-workflow-and-versioning",
        "ci-cd-and-automation",
        "documentation-and-adrs"
      ]
    },
    "skill_paths_resolved": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "budget": {
      "type": "object"
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "context_pointers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "locks_required": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "model_override": {
      "type": "string",
      "description": "Model to use for this stage. Overrides tool default. Set by orchestrator from budgets/default.yaml."
    },
    "continuation": {
      "type": "object",
      "description": "In-stage resume cursor. See shared/continuation.v1.json and runtime/progress-trace.md.",
      "required": ["mode", "progress_path"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["fresh", "resume"]
        },
        "progress_path": {
          "type": "string",
          "minLength": 1
        },
        "resume_from": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "last_seq": { "type": "integer", "minimum": 0 },
            "attempt": { "type": "integer", "minimum": 1 },
            "task_id": { "type": "string" },
            "next_action": { "type": "string" },
            "completed_task_ids": {
              "type": "array",
              "items": { "type": "string" }
            },
            "skills_satisfied": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string" },
                  "evidence": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "context_snapshot": {
      "type": "object",
      "description": "Condensed historical context injected by the orchestrator before each stage spawn. See shared/context-snapshot.v1.json for schema.",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "depth": {
          "type": "string",
          "enum": [
            "minimal",
            "standard",
            "comprehensive"
          ]
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "project_context": {
          "type": "object"
        },
        "current_state": {
          "type": "object"
        },
        "recent_decisions": {
          "type": "array"
        },
        "stage_timeline": {
          "type": "array"
        },
        "open_items": {
          "type": "object"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recent_handoffs": {
          "type": "array"
        },
        "markdown": {
          "type": "string",
          "description": "Full markdown representation of the snapshot"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}